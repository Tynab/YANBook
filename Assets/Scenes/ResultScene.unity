  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a9a45f893942b7e4cbbeda81936ac353, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "C\xE0n t\u01B0\u1EE3ng tr\u01B0ng cho tr\u1EDDi v\xE0 n\u0103ng l\u1EF1c
    s\xE1ng t\u1EA1o. T\u1EA5t c\u1EA3 c\xE1c v\u1EA1ch \u0111\u1EC1u l\xE0 v\u1EA1ch
    li\u1EC1n, t\u1EE9c v\u1EA1ch d\u01B0\u01A1ng, \xFD ngh\u0129a l\xE0 t\u1EA5t
    c\u1EA3 c\xE1c \u0111\u01A1n qu\xE1i li\xEAn k\u1EBFt \u0111\u1EC3 h\u1EE3p th\xE0nh
    tr\xF9ng qu\xE1i n\xE0y, c\u1EA3 qu\u1EBF ch\u1EE7 l\u1EABn qu\u1EBB h\u1ED7,
    \u0111\u1EC1u l\xE0 C\xE0n. \u0110\xF3 l\xE0 t\u1ED9t \u0111\u1EC9nh c\u1EE7a
    d\u01B0\u01A1ng l\u1EF1c. C\xE0n l\xE0 \xE1nh s\xE1ng, s\u1EF1 m\u1EA1nh m\u1EBD,
    t\xEDch c\u1EF1c, \u0111\u1ED3ng th\u1EDDi c\xF2n mang h\xE0m \xFD s\u1EF1 h\xE0nh
    \u0111\u1ED9ng v\xE0 s\u1EF1 b\u1EC1n gan, tr\xEC ch\xED. N\xF3i r\u1ED9ng ra,
    C\xE0n \u0111\u1EA1i \u0111i\u1EC7n cho v\u0169 tr\u1EE5 \u0111ang bi\u1EBFn
    d\u1ECBch kh\xF4ng ng\u1EEBng. Do \u0111\xF3, C\xE0n c\u0169ng h\xE0m \xFD s\u1EF1
    m\xF4 ph\u1ECFng con \u0111\u01B0\u1EDDng c\u1EE7a tr\u1EDDi, con \u0111\u01B0\u1EDDng
    c\u1EA7n c\xF9 trong su\u1ED1t c\u1EA3 ng\xE0y, v\xE0 con \u0111\u01B0\u1EDDng
    c\u1EE7a s\u1EF1 n\u1ED7 l\u1EF1c kh\xF4ng ng\u1EEBng l\u1EABn s\u1EF1 ch\u0103m
    ch\u1EC9, si\xEAng n\u0103ng. Kinh D\u1ECBch t\xECm c\xE1ch \xE1p d\u1EE5ng c\xE1c
    nguy\xEAn l\xFD c\u1EE7a tr\u1EDDi \u0111\u1EA5t v\xE0o c\xF4ng vi\u1EC7c v\xE0
    c\xE1ch h\xE0nh x\u1EED \u0111\u1EA1o \u0111\u1EE9c c\u1EE7a con ng\u01B0\u1EDDi.
    C\xE0n thay \u0111\u1ED5i con \u0111\u01B0\u1EDDng c\u1EE7a tr\u1EDDi, c\xF2n
    qu\u1EBB k\u1EBF ti\u1EBFp, Kh\xF4n, gi\u1EA3i th\xEDch con \u0111\u01B0\u1EDDng
    c\u1EE7a \u0111\u1EA5t. C\u1EA3 hai, tr\u1EDDi v\xE0 \u0111\u1EA5t, \u0111\u1EE9ng
    \u0111\u1EA7u trong Kinh D\u1ECBch.\r\nC\xE0n t\u01B0\u1EE3ng tr\u01B0ng cho
    s\u1EF1 sung th\u1ECBnh c\u1EE7a v\u1EA1n v\u1EADt, kh\u1ECFe m\u1EA1nh, tr\xE1ng
    ki\u1EC7n v\xE0 sum su\xEA. Nh\u01B0ng \u0111ang gi\u1EEFa s\u1EF1 c\u1EF1c d\u01B0\u01A1ng
    th\xEC \xE2m t\u1EA5t s\u1EBD n\u1EA3y sinh. Do \u0111\xF3, l\u1EDDi khuy\xEAn
    l\xE0 n\xEAn th\u1EADt c\u1EA9n th\u1EADn. Bi\u1EBFt l\u01B0u \xFD s\u1EBD tr\xE1nh
    \u0111\u01B0\u1EE3c \u0111i\u1EC1u b\u1EA5t ng\u1EDD v\xE0 s\u1EF1 c\u1ED1."
  m_isRightToLeft: 0
